# Dashboard server settings (documentation only; real values come from the deployment).
# The API origin; the paths in openapi.json already start with /v1.
API_URL=http://localhost:3000
# Digits in a verification code; must equal the API's AUTH_OTP_LENGTH (default 6).
OTP_LENGTH=6
# 1 = use the in-process mocks (auth review accounts, demo endpoints) instead of the API. Local dev and Playwright only.
DASHBOARD_API_MOCK=0
