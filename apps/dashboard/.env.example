# Dashboard server settings (documentation only; real values come from the deployment).
# The API origin; the paths in openapi.json already start with /v1.
API_URL=http://localhost:3000
# The header the edge proxy sets AND overwrites with the client address; see README "Sign-in and session". Set it only
# once the edge does that (nginx: proxy_set_header X-Real-IP $remote_addr; then x-real-ip). Empty: nothing forwarded.
CLIENT_IP_HEADER=
# Digits in a verification code; must equal the API's AUTH_OTP_LENGTH (default 6).
OTP_LENGTH=6
# 1 = use the in-process mocks (auth review accounts, coverage zones store) instead of the API. Local dev and Playwright only.
DASHBOARD_API_MOCK=0
# Raster tile URL template for the coverage map. OSM's own tiles are for light use only: set a provider in production.
NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Media hosts the pages talk to, space-separated: the storage that presigned uploads POST to (S3/MinIO bucket origin)
# and the public CDN that serves logos and covers. Added to the CSP at build time: rebuild after a change.
MEDIA_ORIGINS=
