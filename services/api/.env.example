# Every variable the API reads. The schema in src/config/env.schema.ts validates them at startup.

# Runtime mode: development (readable logs), test (silent logs) or production (JSON logs). Default: development.
NODE_ENV=development
# HTTP port the API listens on, an integer from 1 to 65535. Default: 3000.
PORT=3000
# How long a shutdown (SIGTERM or SIGINT) may take, in ms, from 1000 to 29000. Past it the process logs what
# was still closing and exits with code 1. Keep it below the orchestrator's grace period. Default: 28000.
SHUTDOWN_DEADLINE_MS=28000
# Lowest pino level written to the log: fatal, error, warn, info, debug, trace or silent. Default: info.
LOG_LEVEL=info
# PostgreSQL connection URL (postgresql:// or postgres://). Required. The value below matches docker-compose.yml.
DATABASE_URL=postgresql://jazla:jazla@localhost:5434/jazla
# Connection pool size (1 to 200). Default: 10.
DATABASE_POOL_SIZE=10
# How long opening a database connection may take before it fails, in ms. Default: 5000.
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Transaction defaults (runInTransaction may override them per call): how long a transaction may
# run, and how long it may wait for a pooled connection, in ms. Defaults: 5000 and 2000.
DATABASE_TRANSACTION_TIMEOUT_MS=5000
DATABASE_TRANSACTION_MAX_WAIT_MS=2000
# Isolation level: ReadCommitted, RepeatableRead or Serializable. Default: ReadCommitted.
DATABASE_ISOLATION_LEVEL=ReadCommitted
# Redis connection URL (redis://, or rediss:// for TLS, scheme in lowercase; /<n> picks the logical
# database, 0 to 15). Required.
# The value below matches docker-compose.yml. The e2e tests use the next logical database (/1).
REDIS_URL=redis://localhost:6380/0
# Whether this process runs queue workers (job processors and schedulers): true or false. Producers
# work either way. Required in production, where API processes (false) and worker processes (true)
# run separately; unset elsewhere: true. The e2e tests set false and turn on the workers they need.
QUEUE_WORKERS_ENABLED=true

# API documentation at /docs and /docs-json: true or false. Unset: on in development and test,
# off in production. Set true in production only on purpose.
# API_DOCS_ENABLED=
# Browser origins allowed by CORS, comma-separated, each exactly as the browser sends it
# (https://app.example.com, no path or trailing slash). Empty: CORS is off. * is refused in production.
CORS_ORIGINS=
# Number of proxies (load balancers) in front of the API whose X-Forwarded-For entry is trusted
# for the client address. 0 locally; usually 1 behind one load balancer. Required when NODE_ENV is
# production (no default there); default 0 elsewhere.
TRUST_PROXY_HOPS=0
# Largest JSON body accepted (the only body type), in kilobytes (1 to 10240). Default: 100.
REQUEST_BODY_LIMIT_KB=100
# Default rate limit: at most RATE_LIMIT_MAX_REQUESTS requests per client address in each
# window of RATE_LIMIT_WINDOW_MS milliseconds, across all endpoints. Defaults: 300 per 60000.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
# Limit before routing: at most this many requests of any kind (unknown paths and malformed bodies
# included) per client address in each RATE_LIMIT_WINDOW_MS. Health checks are not counted. Default: 600.
RATE_LIMIT_PRE_ROUTING_MAX_REQUESTS=600

# Object storage, S3-compatible (src/integrations/storage/). The values below match the local MinIO in
# docker-compose.yml; the e2e tests use the same server with the -test buckets.
# Provider implementing the storage port: s3 (the only one). Default: s3.
STORAGE_PROVIDER=s3
# Endpoint of an S3-compatible service. Empty: the provider's own endpoint for the region (AWS S3).
STORAGE_ENDPOINT=http://localhost:9002
# Region name. Required (MinIO accepts any; us-east-1 is its default).
STORAGE_REGION=us-east-1
# true: path-style addressing (endpoint/bucket/key), which MinIO needs. Default: false.
STORAGE_FORCE_PATH_STYLE=true
# Credentials. Required. The values below are the local MinIO's root user (docker-compose.yml) and work
# nowhere else; real credentials come from the deployment's secret store.
STORAGE_ACCESS_KEY_ID=jazla
STORAGE_SECRET_ACCESS_KEY=jazla-local-storage
# Two buckets, never one: public objects (product and catalog images) are readable anonymously,
# private ones (documents, order photos, dispute evidence) only through presigned URLs. Required.
STORAGE_PUBLIC_BUCKET=jazla-public
STORAGE_PRIVATE_BUCKET=jazla-private
# Where public objects are read from: <base>/<object key>. The CDN in production; locally the public
# bucket's own URL. No trailing slash. Required. The e2e tests expect it to end with /<STORAGE_PUBLIC_BUCKET>.
STORAGE_PUBLIC_BASE_URL=http://localhost:9002/jazla-public
# How long a presigned upload (60 to 3600) and a presigned download (60 to 86400) stay valid, in
# seconds. Defaults: 300 and 300.
STORAGE_UPLOAD_URL_EXPIRY_SECONDS=300
STORAGE_DOWNLOAD_URL_EXPIRY_SECONDS=300
# How long an upload may stay unconfirmed before the cleanup job removes it (300 to 604800, more than
# STORAGE_UPLOAD_URL_EXPIRY_SECONDS), and how often that job runs (60 to 86400), in seconds.
# Defaults: 3600 and 900.
MEDIA_PENDING_UPLOAD_TTL_SECONDS=3600
MEDIA_CLEANUP_INTERVAL_SECONDS=900

# Not read by the API: the host ports docker-compose.yml publishes the services on.
# Database, default 5434:
# JAZLA_DB_PORT=5434
# Redis, default 6380:
# JAZLA_REDIS_PORT=6380
# MinIO's S3 API, default 9002, and its web console, default 9003:
# JAZLA_MINIO_PORT=9002
# JAZLA_MINIO_CONSOLE_PORT=9003
