{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-seed",
    "tsBuildInfoFile": "./dist-seed/tsconfig.seed.tsbuildinfo"
  },
  "include": ["src", "prisma/seed"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "dist-seed",
    "**/*spec.ts",
    "**/*.fake.ts",
    "src/integrations/*/testing.ts",
    "src/integrations/*/providers/fake.provider.ts"
  ]
}
