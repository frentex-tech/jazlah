// Domain: audit. Owned by infrastructure; any module may write an entry.

/// Append-only record of who did what to which entity. An entry is written by the code
/// that makes the change and is never updated or deleted.
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nullable: null when the action was taken by the system (a job, a webhook), not a user.
  actorId   String?  @map("actor_id") @db.Uuid
  /// What happened, `domain.entity.action` (for example `orders.order.cancelled`).
  action    String
  /// The kind of entity acted on (for example `order`).
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  /// Extra facts about the action. Never secrets or unmasked personal data.
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@map("audit_logs")
}
