// Domain: media. Owned by the media module (src/modules/media/): the files clients upload
// to object storage, from the upload request until they are ready or rejected.

/// Who may read a file: anyone (public bucket, stable URL) or only through a presigned URL.
enum MediaVisibility {
  public
  private

  @@map("media_visibility")
}

/// pending: requested, not confirmed yet; ready: confirmed and checked (the checked copy is
/// at bucket and object_key); rejected: failed a check (or expired before confirmation),
/// objects deleted.
enum MediaStatus {
  pending
  ready
  rejected

  @@map("media_status")
}

/// Why a file was rejected.
enum MediaRejectionReason {
  /// Nothing was uploaded at the location.
  OBJECT_MISSING
  /// The object is empty.
  EMPTY_FILE
  /// The object is larger than the purpose allows.
  TOO_LARGE
  /// Its real type, read from its first bytes, is not one the purpose allows.
  TYPE_NOT_ALLOWED
  /// Its real type differs from the Content-Type it was uploaded with.
  CONTENT_TYPE_MISMATCH
  /// It was not confirmed in time; the cleanup job deletes the object and then the row.
  EXPIRED
  /// Its owner deleted their account; the cleanup job deletes the object and then the row.
  OWNER_DELETED

  @@map("media_rejection_reason")
}

/// One uploaded file. The client uploads to a staging key in the private bucket
/// (`staging/<purpose path>/<yyyy>/<mm>/<dd>/<id>`); confirmation copies it to a final key
/// in the purpose's bucket that no upload ticket names (`<purpose path>/<yyyy>/<mm>/<dd>/
/// <id>/<attempt>`), checks that copy, and only then marks the row ready. Keys are
/// generated by the server; the client's file name is metadata only. A ready row always
/// has its location (check constraint `media_ready_location_check`).
model Media {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The upload purpose (`catalog.product-image`), from UPLOAD_PURPOSES in the media module.
  purpose             String
  visibility          MediaVisibility
  /// Nullable: null until the file is ready; the bucket of the checked copy.
  bucket              String?
  /// Nullable: null until the file is ready; the key of the checked copy.
  objectKey           String?               @map("object_key")
  /// Nullable: null once the cleanup has removed the staging object for good, after the
  /// upload ticket expired. The key in the private bucket that the ticket writes to.
  stagingKey          String?               @map("staging_key")
  status              MediaStatus           @default(pending)
  /// Nullable: null until the upload is confirmed and checked.
  sizeBytes           Int?                  @map("size_bytes")
  /// Nullable: null until the upload is confirmed; the type read from the file's first bytes.
  detectedContentType String?               @map("detected_content_type")
  /// Nullable: null when the client sent no usable file name. Sanitised; display only.
  originalFileName    String?               @map("original_file_name")
  /// Nullable: null until authentication exists, and for files the system creates.
  ownerId             String?               @map("owner_id") @db.Uuid
  /// Nullable: null unless the status is rejected.
  rejectionReason     MediaRejectionReason? @map("rejection_reason")
  /// The last moment the upload may be confirmed; past it the cleanup job removes it. Always
  /// after the ticket's own expiry (config), so past it no ticket can write any more.
  expiresAt           DateTime              @map("expires_at") @db.Timestamptz(3)
  /// Nullable: null until the file becomes ready.
  confirmedAt         DateTime?             @map("confirmed_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendorLogos                Vendor[]
  vendorApplicationDocuments VendorApplicationDocument[]
  productImages              ProductImage[]

  @@unique([bucket, objectKey], map: "media_bucket_object_key_key")
  @@index([status, expiresAt])
  @@index([ownerId])
  @@map("media")
}
