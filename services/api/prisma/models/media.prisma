// Domain: media. Owned by the media module (src/modules/media/): the files clients upload
// to object storage, from the upload request until they are ready or rejected.

/// Who may read a file: anyone (public bucket, stable URL) or only through a presigned URL.
enum MediaVisibility {
  public
  private

  @@map("media_visibility")
}

/// pending: requested, not confirmed yet; ready: confirmed and checked; rejected: failed a
/// check (or expired before confirmation), object deleted.
enum MediaStatus {
  pending
  ready
  rejected

  @@map("media_status")
}

/// Why a file was rejected.
enum MediaRejectionReason {
  /// Nothing was uploaded at the location.
  OBJECT_MISSING
  /// The object is empty.
  EMPTY_FILE
  /// The object is larger than the purpose allows.
  TOO_LARGE
  /// Its real type, read from its first bytes, is not one the purpose allows.
  TYPE_NOT_ALLOWED
  /// Its real type differs from the Content-Type it was uploaded with.
  CONTENT_TYPE_MISMATCH
  /// It was not confirmed in time; the cleanup job deletes the object and then the row.
  EXPIRED

  @@map("media_rejection_reason")
}

/// One uploaded file. The object key is generated by the server
/// (`<purpose path>/<yyyy>/<mm>/<dd>/<id>`); the client's file name is metadata only.
model Media {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The upload purpose (`catalog.product-image`), from UPLOAD_PURPOSES in the media module.
  purpose             String
  visibility          MediaVisibility
  bucket              String
  objectKey           String                @map("object_key")
  status              MediaStatus           @default(pending)
  /// Nullable: null until the upload is confirmed and checked.
  sizeBytes           Int?                  @map("size_bytes")
  /// Nullable: null until the upload is confirmed; the type read from the file's first bytes.
  detectedContentType String?               @map("detected_content_type")
  /// Nullable: null when the client sent no usable file name. Sanitised; display only.
  originalFileName    String?               @map("original_file_name")
  /// Nullable: null until authentication exists, and for files the system creates.
  ownerId             String?               @map("owner_id") @db.Uuid
  /// Nullable: null unless the status is rejected.
  rejectionReason     MediaRejectionReason? @map("rejection_reason")
  /// The last moment the upload may be confirmed; past it the cleanup job removes it.
  expiresAt           DateTime              @map("expires_at") @db.Timestamptz(3)
  /// Nullable: null until the file becomes ready.
  confirmedAt         DateTime?             @map("confirmed_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([bucket, objectKey], map: "media_bucket_object_key_key")
  @@index([status, expiresAt])
  @@index([ownerId])
  @@map("media")
}
