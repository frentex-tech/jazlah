// Domain: idempotency. Owned by infrastructure (src/infra/database/idempotency-runner.ts);
// any module records its once-only operations here through IdempotencyRunner.

/// One operation that must happen exactly once (a payment webhook, a ledger effect, an SMS
/// that must not be sent twice), keyed by what identifies it. Written in the same
/// transaction as the work, so the key exists exactly when the work's effects are committed.
model IdempotencyKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// What the work is, kebab-case (for example `payment-webhook`).
  operation String
  /// What identifies one run of it (for example the provider's event id).
  key       String
  /// The work's result as `{ "value": <result> }`, returned to every repeat. Nullable: null
  /// only while the claiming transaction runs the work; claim and outcome commit together,
  /// so no other transaction ever reads a null.
  outcome   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([operation, key], map: "idempotency_keys_operation_key_key")
  @@map("idempotency_keys")
}
