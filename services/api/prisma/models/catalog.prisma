// Domain: catalog. Owned by the catalog module (src/modules/catalog/): the admin lists
// (categories, meat types, cutting styles, exclusion items, cutting and packaging
// incompatibilities), products with their options, and the change requests on published
// products.

/// Where a product is in its review. A vendor's draft goes to pending_review when
/// submitted, then published or rejected by an admin; a rejected product is edited and
/// submitted again. The platform vendor's products go from draft to published directly.
enum ProductStatus {
  draft
  pending_review
  published
  rejected

  @@map("product_status")
}

/// How a product reaches the customer (FR-PRD-07).
enum ProductFulfilment {
  delivery
  pickup
  both

  @@map("product_fulfilment")
}

/// The packaging a product is offered in (FR-PRD-04); a product prices each packaging it
/// offers (`product_packagings.extra_price_halalas`).
enum ProductPackaging {
  trays
  bags
  vacuum
  none

  @@map("product_packaging")
}

/// Where a change request on a published product is: pending until an admin approves or
/// rejects it.
enum ProductChangeRequestStatus {
  pending
  approved
  rejected
  superseded

  @@map("product_change_request_status")
}

/// A product category (FR-CAT-01, FR-ADM-02), managed by admins. Only an active
/// category's products are shown publicly.
model Category {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr       String   @map("name_ar")
  nameEn       String   @map("name_en")
  isActive     Boolean  @default(true) @map("is_active")
  /// The display order admins set, lower first (the public categories); never negative.
  sortOrder    Int      @default(0) @map("sort_order")
  /// Nullable: null until an admin sets an image, and when its file is deleted. A ready
  /// `catalog.category-image` file.
  imageMediaId String?  @map("image_media_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  image    Media?    @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([imageMediaId])
  @@index([isActive, createdAt, id])
  @@index([isActive, sortOrder, createdAt, id])
  @@index([createdAt, id])
  @@map("categories")
}

/// A kind of meat (lamb, beef, camel…), managed by admins; a product has at most one.
model MeatType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive, createdAt, id])
  @@index([createdAt, id])
  @@map("meat_types")
}

/// A cutting style (FR-PRD-03), managed by admins and offered per product.
model CuttingStyle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  productCuttings   ProductCutting[]
  incompatibilities CuttingPackagingIncompatibility[]

  @@index([isActive, createdAt, id])
  @@index([createdAt, id])
  @@map("cutting_styles")
}

/// A "without" item (FR-PRD-05: head, trotters, tripe, liver, tail fat), managed by
/// admins and offered per product.
model ExclusionItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  productExclusions ProductExclusion[]

  @@index([isActive, createdAt, id])
  @@index([createdAt, id])
  @@map("exclusion_items")
}

/// A global rule (FR-PRD-04): this cutting style cannot be packed this way. A product
/// offering both cannot be submitted.
model CuttingPackagingIncompatibility {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cuttingStyleId String           @map("cutting_style_id") @db.Uuid
  packaging      ProductPackaging
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  cuttingStyle CuttingStyle @relation(fields: [cuttingStyleId], references: [id], onDelete: Restrict)

  @@unique([cuttingStyleId, packaging], map: "cutting_packaging_incompatibilities_pair_key")
  @@index([createdAt, id])
  @@map("cutting_packaging_incompatibilities")
}

/// A product a vendor sells (the platform vendor's are JAZLA's own). Shown publicly only
/// when published, available, its vendor active and its category active; the public
/// lists use the `products_listing_*` indexes (not partial indexes: Prisma sends the
/// status as a cast parameter, from which PostgreSQL cannot prove a partial index's
/// condition). The review fields follow the status (check constraint
/// `products_review_check`).
model Product {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId        String            @map("vendor_id") @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  /// Nullable: null when the product names no meat type.
  meatTypeId      String?           @map("meat_type_id") @db.Uuid
  nameAr          String            @map("name_ar")
  nameEn          String            @map("name_en")
  /// Nullable: null until a description is written.
  descriptionAr   String?           @map("description_ar")
  /// Nullable: null until a description is written.
  descriptionEn   String?           @map("description_en")
  /// The names in both languages, normalised for search by the SQL function
  /// `catalog_search_text`. Written only by the trigger `products_search_text_trigger`,
  /// never by code (the default only satisfies Prisma's create types).
  searchText      String            @default("") @map("search_text")
  status          ProductStatus     @default(draft)
  isAvailable     Boolean           @default(true) @map("is_available")
  fulfilment      ProductFulfilment
  /// Nullable: null while the product has no size. The lowest size price, kept in step
  /// with product_sizes in the same transaction (check constraint
  /// `products_min_price_check`).
  minPriceHalalas Int?              @map("min_price_halalas")
  /// Nullable: null unless the product is rejected. The admin's reason, shown to the vendor.
  rejectionReason String?           @map("rejection_reason")
  /// Nullable: null until the product is first submitted for review.
  submittedAt     DateTime?         @map("submitted_at") @db.Timestamptz(3)
  /// Nullable: null until an admin approves, rejects or publishes it.
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  /// Nullable: null until an admin approves, rejects or publishes it.
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  /// Nullable: null until the product is first published.
  publishedAt     DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor         Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category       Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  meatType       MeatType?                @relation(fields: [meatTypeId], references: [id], onDelete: Restrict)
  reviewedBy     User?                    @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  images         ProductImage[]
  sizes          ProductSize[]
  cuttings       ProductCutting[]
  packagings     ProductPackagingOption[]
  exclusions     ProductExclusion[]
  changeRequests ProductChangeRequest[]

  @@index([vendorId, createdAt, id])
  /// Also the public list filtered by vendor (is_available checked on the rows read).
  @@index([vendorId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([createdAt, id])
  /// The public list, newest first: status and availability as index conditions.
  @@index([status, isAvailable, createdAt(sort: Desc), id(sort: Desc)], map: "products_listing_idx")
  /// The public list filtered by category; also the category_id foreign key's index.
  @@index([categoryId, status, isAvailable, createdAt(sort: Desc), id(sort: Desc)], map: "products_listing_category_idx")
  /// The public list filtered by meat type; also the meat_type_id foreign key's index.
  @@index([meatTypeId, status, isAvailable, createdAt(sort: Desc), id(sort: Desc)], map: "products_listing_meat_type_idx")
  @@index([reviewedById])
  /// The text search on the public list (trigram, `contains`).
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_idx")
  @@map("products")
}

/// A product's image, a ready `catalog.product-image` file, in display order (0 first).
model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, position], map: "product_images_product_id_position_key")
  @@unique([productId, mediaId], map: "product_images_product_id_media_id_key")
  @@index([mediaId])
  @@map("product_images")
}

/// A size of a product (FR-PRD-02): an approximate weight, its own price and an optional
/// tag ("enough for an aqiqah"), in display order (0 first). Price and weight are checked
/// (check constraint `product_sizes_values_check`); the tag is in both languages or none
/// (`product_sizes_tag_check`).
model ProductSize {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  approxWeightGrams Int      @map("approx_weight_grams")
  priceHalalas      Int      @map("price_halalas")
  /// Nullable: null when the size has no tag.
  tagAr             String?  @map("tag_ar")
  /// Nullable: null when the size has no tag.
  tagEn             String?  @map("tag_en")
  position          Int
  /// Whether this size can be ordered now; switched by the availability edit, at once.
  isAvailable       Boolean  @default(true) @map("is_available")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position], map: "product_sizes_product_id_position_key")
  @@map("product_sizes")
}

/// A cutting style a product offers (FR-PRD-03), with an optional extra price (0 when
/// none; check constraint `product_cuttings_extra_price_check`).
model ProductCutting {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  cuttingStyleId    String   @map("cutting_style_id") @db.Uuid
  extraPriceHalalas Int      @default(0) @map("extra_price_halalas")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  cuttingStyle CuttingStyle @relation(fields: [cuttingStyleId], references: [id], onDelete: Restrict)

  @@unique([productId, cuttingStyleId], map: "product_cuttings_product_id_cutting_style_id_key")
  @@index([cuttingStyleId])
  @@map("product_cuttings")
}

/// A packaging a product is offered in (FR-PRD-04), with an optional extra price (0 when
/// none; check constraint `product_packagings_extra_price_check`), changed like a
/// cutting's.
model ProductPackagingOption {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String           @map("product_id") @db.Uuid
  packaging         ProductPackaging
  extraPriceHalalas Int              @default(0) @map("extra_price_halalas")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, packaging], map: "product_packagings_product_id_packaging_key")
  @@map("product_packagings")
}

/// A "without" item a product offers (FR-PRD-05).
model ProductExclusion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  exclusionItemId String   @map("exclusion_item_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  exclusionItem ExclusionItem @relation(fields: [exclusionItemId], references: [id], onDelete: Restrict)

  @@unique([productId, exclusionItemId], map: "product_exclusions_product_id_exclusion_item_id_key")
  @@index([exclusionItemId])
  @@map("product_exclusions")
}

/// A vendor's edit of a published product, waiting for an admin while the live version
/// stays. At most one pending per product (partial unique index
/// `product_change_requests_product_id_pending_key`). A request never changes after it is
/// created: a second edit closes the pending one as `superseded` and opens a new one. The
/// review fields are set exactly when an admin decided (check constraint
/// `product_change_requests_review_check`).
model ProductChangeRequest {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String                     @map("product_id") @db.Uuid
  requestedById   String                     @map("requested_by_id") @db.Uuid
  status          ProductChangeRequestStatus @default(pending)
  /// The proposed content (names, descriptions, category, meat type, images, sizes,
  /// cuttings, packagings, exclusions), validated when read (ProductContent).
  content         Json                       @db.JsonB
  /// Nullable: null unless rejected. The admin's reason, shown to the vendor.
  rejectionReason String?                    @map("rejection_reason")
  /// Nullable: null unless an admin decided it (approved or rejected).
  reviewedAt      DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  /// Nullable: null unless an admin decided it (approved or rejected).
  reviewedById    String?                    @map("reviewed_by_id") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ProductChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?   @relation("ProductChangeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([requestedById])
  @@index([reviewedById])
  @@map("product_change_requests")
}
