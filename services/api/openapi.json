  "info": {
    "title": "JAZLA API",
    "description": "Every route is under the /v1 prefix; the paths below include it.\n\nAmounts are integer halalas; timestamps are UTC (ISO 8601).\n\nEvery error response has the ErrorResponseDto shape; clients branch on its code.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token from the authentication endpoints."
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "A Saudi mobile number, in any usual form (05…, 5…, 9665…, +9665…), with Latin or Arabic digits.",
            "example": "0512345678"
          },
          "audience": {
            "type": "string",
            "enum": [
              "customer",
              "vendor",
              "kitchen",
              "admin"
            ],
            "description": "The application the user is signing in to.",
            "example": "customer"
          }
        },
        "required": [
          "phone",
          "audience"
        ]
      },
      "OtpRequestedResponseDto": {
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "number",
            "description": "How long the code can be used, in seconds.",
            "example": 300
          },
          "resendAfterSeconds": {
            "type": "number",
            "description": "How long to wait before asking for another code, in seconds.",
            "example": 60
          }
        },
        "required": [
          "expiresInSeconds",
          "resendAfterSeconds"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the invalid field.",
            "example": "address.city"
          },
          "constraints": {
            "description": "Names of the failed checks (class-validator constraint names), stable and language-neutral.",
            "example": [
              "isString",
              "isNotEmpty"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "constraints"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "BAD_REQUEST",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "RATE_LIMITED",
          "TRANSACTION_CONFLICT",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_ERROR",
          "MEDIA_CONTENT_TYPE_NOT_ALLOWED",
          "MEDIA_NOT_FOUND",
          "MEDIA_UPLOAD_EXPIRED",
          "MEDIA_UPLOAD_REJECTED",
          "MEDIA_NOT_READY",
          "OTP_INVALID",
          "OTP_EXPIRED",
          "REFRESH_TOKEN_INVALID",
          "ACCESS_TOKEN_EXPIRED",
          "ACCOUNT_DISABLED"
        ],
        "description": "Stable error code. Clients branch on it; it is never renamed or reused."
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "description": "Stable error code. Clients branch on it; it is never renamed or reused.",
            "example": "NOT_FOUND",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Message for a person, in Arabic unless Accept-Language prefers English. Never branch on it.",
            "example": "The requested resource was not found."
          },
          "details": {
            "description": "More about the error. For VALIDATION_FAILED, the list of invalid fields; otherwise an object whose fields depend on the code.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldErrorDto"
                }
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Id of the request, also in the x-request-id response header. Quote it when reporting a problem.",
            "example": "3f2b8c1e-7d4a-4b6f-9a2e-5c8d1f0e6b7a"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "The phone number the code was requested for.",
            "example": "0512345678"
          },
          "audience": {
            "type": "string",
            "enum": [
              "customer",
              "vendor",
              "kitchen",
              "admin"
            ],
            "description": "The audience the code was requested for.",
            "example": "customer"
          },
          "code": {
            "type": "string",
            "description": "The code from the message: 4 to 8 digits, Latin or Arabic (٠ to ٩, ۰ to ۹). Surrounding spaces and invisible format characters (direction marks, zero-width characters) are ignored.",
            "example": "482913"
          },
          "devicePlatform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ],
            "description": "The kind of client signing in.",
            "example": "ios"
          },
          "deviceName": {
            "type": "string",
            "description": "A name for the device, shown in the list of sessions.",
            "example": "iPhone 16",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "phone",
          "audience",
          "code",
          "devicePlatform"
        ]
      },
      "PrincipalResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "6f1c0c53-3f0b-4d0a-9a6f-2f0f0f8f7a11"
          },
          "phone": {
            "type": "string",
            "description": "The phone number, masked.",
            "example": "+966*******78"
          },
          "audience": {
            "type": "string",
            "enum": [
              "customer",
              "vendor",
              "kitchen",
              "admin"
            ],
            "description": "The one audience this sign-in is for.",
            "example": "customer"
          },
          "organisationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "The vendor or kitchen the user acts for; null for customers and admins.",
            "example": null
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "example": "0b9f6a0e-58e5-4f6b-8e0a-5a1d3d0c2b10"
          }
        },
        "required": [
          "userId",
          "phone",
          "audience",
          "organisationId",
          "sessionId"
        ]
      },
      "SignedInResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Sent as `Authorization: Bearer <token>` on every request.",
            "example": "eyJhbGciOi…"
          },
          "accessTokenExpiresInSeconds": {
            "type": "number",
            "description": "How long the access token lives, in seconds.",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Exchanged once for a new pair when the access token expires. Keep it in secure storage.",
            "example": "q3vX…"
          },
          "refreshTokenExpiresInSeconds": {
            "type": "number",
            "description": "How long the refresh token lives, in seconds.",
            "example": 2592000
          },
          "principal": {
            "$ref": "#/components/schemas/PrincipalResponseDto"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresInSeconds",
          "refreshToken",
          "refreshTokenExpiresInSeconds",
          "principal"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token of the session.",
            "example": "q3vX…",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Sent as `Authorization: Bearer <token>` on every request.",
            "example": "eyJhbGciOi…"
          },
          "accessTokenExpiresInSeconds": {
            "type": "number",
            "description": "How long the access token lives, in seconds.",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Exchanged once for a new pair when the access token expires. Keep it in secure storage.",
            "example": "q3vX…"
          },
          "refreshTokenExpiresInSeconds": {
            "type": "number",
            "description": "How long the refresh token lives, in seconds.",
            "example": 2592000
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresInSeconds",
          "refreshToken",
          "refreshTokenExpiresInSeconds"
        ]
      },
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always ok: the process answers.",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up"
          },
          "redis": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up"
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "ok (HTTP 200) when every dependency is up; unavailable (HTTP 503) when one is down or the instance is shutting down.",
            "enum": [
              "ok",
              "unavailable"
            ],
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          },
          "draining": {
            "type": "boolean",
            "description": "Present, true, while the instance shuts down: status is then unavailable (HTTP 503) whatever the checks say.",
            "enum": [
              true
            ],
            "example": true
          }
        },
        "required": [
          "status",
          "checks"
        ]
      }
    }
  }
}
