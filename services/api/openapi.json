{
  "openapi": "3.0.0",
  "paths": {
    "/v1/public/auth/otp/request": {
      "post": {
        "description": "The answer is the same whether or not the phone may sign in to the audience. A new code replaces the previous one. Asking again before `resendAfterSeconds` has passed is RATE_LIMITED with Retry-After.",
        "operationId": "PublicAuthController_request",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestedResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Error. code: VALIDATION_FAILED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Error. code: RATE_LIMITED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Error. code: INTERNAL_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Error. code: SERVICE_UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Send a verification code to a phone number",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/public/auth/otp/verify": {
      "post": {
        "description": "OTP_INVALID: the code is wrong (the attempt is counted). OTP_EXPIRED: no code can be verified any more; request a new one.",
        "operationId": "PublicAuthController_verify",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpDto"
