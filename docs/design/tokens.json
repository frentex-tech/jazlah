{
  "$meta": {
    "name": "Jazlah design tokens",
    "status": "approved-direction",
    "source": "Brand + app prototype shown to and approved by the client (burgundy & gold, Turki-like premium butcher feel). See docs/design/README.md.",
    "note": "Colors and fonts are approved. The logo/wordmark must be redrawn for the name Jazlah (DSN-DES-1). Money/RTL rules: see docs/architecture.md."
  },
  "color": {
    "brand":        { "value": "#4A1014", "use": "primary surfaces, app bar, primary buttons on light" },
    "brand-2":      { "value": "#6A1A20", "use": "pressed/hover of brand, gradients" },
    "brand-deep":   { "value": "#240709", "use": "splash, dark hero backgrounds" },
    "gold":         { "value": "#C99A52", "use": "accent, highlights, price emphasis on dark, icons on brand" },
    "gold-text":    { "value": "#B0823F", "use": "gold used as text/icon on light backgrounds (contrast)" },
    "gold-light":   { "value": "#D9AE62", "use": "gold on dark backgrounds, chips on brand" },
    "gold-gradient":{ "value": ["#F7E6BC", "#DDB46A", "#AE7C37", "#EBCB8C"], "use": "logo / emblem only, never body UI" },
    "ember":        { "value": "#8E1F26", "use": "call-to-action, focus ring, active states" },
    "ember-2":      { "value": "#6E161C", "use": "pressed CTA" },
    "bg":           { "value": "#F7F0E8", "use": "app background (cream)" },
    "paper":        { "value": "#FFFBF7", "use": "cards, sheets" },
    "sand":         { "value": "#EEDFD3", "use": "secondary surfaces, inputs" },
    "line":         { "value": "#E9D9CD", "use": "dividers, borders" },
    "ink":          { "value": "#2A1215", "use": "primary text" },
    "ink-2":        { "value": "#55383A", "use": "secondary text" },
    "muted":        { "value": "#8E7470", "use": "hints, captions, disabled text" },
    "success":      { "value": "#3F7A4E", "use": "success, freshness verified, delivered" },
    "info":         { "value": "#2B5566", "use": "informational badges" }
  },
  "font": {
    "body":    { "family": "Readex Pro", "weights": [300, 400, 500, 600, 700], "use": "all UI text, Arabic + Latin" },
    "display": { "family": "El Messiri", "weights": [600, 700], "use": "headings, hero titles, prices on hero" }
  },
  "radius": { "lg": 26, "md": 18, "sm": 12, "pill": 999 },
  "shadow": { "card": "0 1px 2px rgba(42,18,21,.06), 0 8px 24px -12px rgba(42,18,21,.18)" },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48] }
}
